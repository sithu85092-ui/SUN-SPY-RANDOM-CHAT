rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    match /coinTransactions/{id} { allow read, write: if false; }
    match /auditLogs/{id} { allow read, write: if false; }
    match /reports/{id} { allow read, write: if false; }
  }
}
